<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>EffectsLauncher</StartupObject>
    <AssemblyName>Play with Effects</AssemblyName>
    <Version>0.6.9</Version>
    <RootNamespace>NeonLoop</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>embedded</DebugType>
    <Product>NeonLoop</Product>
    <Company>Good Trip Good Tip</Company>
    <ApplicationIcon>Installer.ico</ApplicationIcon>
    <ApplicationManifest>Installer.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Effects/EffectsLauncher.cs;Effects/EffectsWindow.cs;Effects/MusicPack.cs;Effects/SteamGame.cs;Effects/CutsceneSetup.cs;Effects/CutsceneTiming.cs;Effects/NetworkPrivacy.cs;Effects/InstallWizard.cs;Effects/InstallSession.cs;Effects/InstallAssets.cs;Effects/InstallFiles.cs;Effects/InstallHardware.cs;Effects/LocalInstallerFiles.cs" />
    <Compile Include="InstallerShared/Core/*.cs" />
    <Compile Include="InstallerShared/WinForms/*.cs" Exclude="InstallerShared/WinForms/InstallReviewDialog.cs;InstallerShared/WinForms/InstallNoticeDialog.cs" />
    <Compile Include="Effects/SetupPackage.cs;Effects/ManagedInstall.cs;Effects/InstallStorage.cs" />
    <Compile Include="Effects/EasyInstall.cs;Effects/Music/PatchScore.cs;Effects/Gameplay/GameplayPatch.cs;Effects/Gameplay/GameplayDefaults.cs" />
    <Reference Include="Mono.Cecil" HintPath="Effects/Vendor/Mono.Cecil/Mono.Cecil.dll" />
    <EmbeddedResource Include="InstallerShared/HOBBY-TERMS.txt" LogicalName="GameInstaller.HobbyTerms.txt" />
  </ItemGroup>
</Project>
